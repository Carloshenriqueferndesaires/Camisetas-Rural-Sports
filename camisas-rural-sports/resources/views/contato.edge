<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contato - Rural Sports</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />

  <style>
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      font-family: "Inter", sans-serif;
      font-weight: 400;
    }

   
    .main {
      min-height: 100vh;
      width: 100%;
      background-color: #0f0c25; 
      color: #fff;
      padding-bottom: 40px; 
    }

   
    .nav-part-1 ul li a {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .nav {
      height: 110px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 50px;
      background-color: #d0d4d5; 
      color: #000;
    }

    .nav-part-1 {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .nav img {
      height: 80px;
      width: auto;
      margin-right: 60px;
      cursor: pointer;
    }

    .nav-part-1 ul {
      display: flex;
      align-items: center;
      justify-content: center;
      list-style: none;
    }

    .nav-part-1 ul li {
      margin-right: 40px;
      font-size: 19px;
      font-weight: 500;
      text-transform: uppercase;
      cursor: pointer;
      position: relative;
      transition: color 0.3s ease;
    }

    .nav-part-1 ul li::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -5px;
      height: 2px;
      width: 0%;
      background-color: #2c7a7b;
      transition: width 0.3s ease;
    }

    .nav-part-1 ul li:hover {
      color: #2c7a7b;
    }

    .nav-part-1 ul li:hover::after {
      width: 100%;
    }

    .nav-part-2 i {
      margin-right: 40px;
      font-size: 21px;
      cursor: pointer;
      transition: all 0.3s ease;
      color: #000; 
    }

    .nav-part-2 i:hover {
      color: #2c7a7b;
      transform: scale(1.2);
      text-shadow: 0 0 10px rgba(44, 122, 123, 0.5);
    }

    .contact-container {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 50px;
      padding: 40px 80px;
      max-width: 1200px;
      margin: 40px auto;
    }
    
    .contact-form {
      background: #14122b;
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 0 15px rgba(0,255,191,0.08);
      width: 60%;
      max-width: 600px;
    }
    
    .contact-info {
      width: 40%;
      max-width: 400px;
      padding: 40px;
      background: #14122b;
      border-radius: 20px;
      box-shadow: 0 0 15px rgba(0,255,191,0.08);
    }
    
    h1 {
      text-align: center;
      color: aquamarine;
      margin-bottom: 30px;
    }

    .contact-form h2, .contact-info h2 {
        color: #fff;
        margin-bottom: 20px;
        font-size: 24px;
        padding-bottom: 10px;
        border-bottom: 1px solid #1e1c2e;
    }

    input, textarea {
      width: 100%;
      margin: 10px 0;
      padding: 12px 15px;
      border-radius: 10px;
      border: none;
      background: #1e1c2e;
      color: #b6b6b6;
      font-size: 16px;
      resize: vertical;
    }
    
    input::placeholder, textarea::placeholder {
        color: #b6b6b6;
    }

    .submit-btn {
      background: rgb(0, 255, 191);
      border: none;
      padding: 12px 25px;
      border-radius: 25px;
      font-weight: bold;
      cursor: pointer;
      color: #141414;
      font-size: 16px;
      width: 100%;
      margin-top: 20px;
      transition: 0.3s;
    }
    
    .submit-btn:hover {
        background-color: rgb(0, 230, 170);
        transform: scale(1.01);
    }
    
    
    .info-item {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        gap: 15px;
    }

    .info-item i {
        font-size: 24px;
        color: aquamarine;
    }

    .info-item p {
        margin: 0;
        color: #ccc;
    }
    
    .info-item a {
        color: aquamarine;
        text-decoration: none;
    }

    .info-item a:hover {
        text-decoration: underline;
    }

   
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.5);
      justify-content: center;
      align-items: center;
    }

    .modal-content {
      background-color: #14122b;
      color: #fff;
      border-radius: 15px;
      padding: 30px;
      width: 320px;
      text-align: center;
      position: relative;
      box-shadow: 0 0 15px rgba(0, 255, 191, 0.08);
    }

    .close {
      position: absolute;
      top: 10px;
      right: 15px;
      font-size: 24px;
      cursor: pointer;
      color: aquamarine;
    }

    .close:hover {
      color: #2c7a7b;
    }
    
    input[readonly] {
      border: none;
      background: transparent;
      color: #fff;
      width: 80%;
      text-align: center;
      font-size: 15px;
    }

    .modal-content input {
      width: 90%;
      max-width: 250px;
      background-color: #1e1c2e;
      color: #fff;
      border-radius: 10px;
      padding: 6px;
      border: 1px solid transparent;
      text-align: center;
      transition: all 0.3s;
    }
    
    .btn-edit, .btn-logout {
      display: inline-block;
      background-color: aquamarine;
      color: #141414;
      border: none;
      padding: 10px 25px;
      border-radius: 25px;
      cursor: pointer;
      font-weight: bold;
      margin-top: 10px;
      transition: 0.3s;
    }

    .btn-edit:hover, .btn-logout:hover {
      background-color: rgb(0, 230, 170);
      transform: scale(1.05);
    }

    .modal-content p {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin: 10px 0;
    }

    .modal-content p strong {
      display: block;
      margin-bottom: 5px;
    }
    
    @media (max-width: 900px) {
        .contact-container {
            flex-direction: column;
            padding: 20px;
            align-items: center;
        }
        .contact-form, .contact-info {
            width: 100%;
            max-width: none;
            margin-bottom: 20px;
        }
    }
  </style>
</head>

<body>
  <div class="main">
    <div class="nav">
      <div class="nav-part-1">
        <img src="imagem/logo_pagina_inicial.png" alt="logo" onclick="window.location.href='/'" style="cursor: pointer;" />
        <ul>
          <li><a href="/">Início</a></li>
          <li><a href="/masculino">Homem</a></li>
          <li><a href="/feminino">Mulher</a></li>
          <li><a href="/colecao">Coleção</a></li>
          <li style="color: #2c7a7b;"><a href="/contato">Contato</a></li>
             <li><a href="/meus-pedidos">Meus Pedidos</a></li>
        </ul>
      </div>

      <div class="nav-part-2">
        <i class="ri-user-line" id="profileIcon"></i>
        <i class="ri-search-line" onclick="window.location.href='/busca'"></i>
        <i class="ri-shopping-cart-2-line" onclick="window.location.href='/carrinho'"></i>
        <i class="ri-menu-line"></i>
      </div>
    </div>

    <div class="contact-container">
        
        <div class="contact-form">
            <h2>Envie uma Mensagem</h2>
            <form method="POST" action="/contato/enviar">
                
                <input type="text" name="name" placeholder="Seu Nome Completo" required>
                <input type="email" name="email" placeholder="Seu Melhor Email" required>
                <input type="text" name="subject" placeholder="Assunto (Ex: Dúvida sobre Pedido #123)" required>
                <textarea name="message" rows="5" placeholder="Sua Mensagem..." required></textarea>
                
                <button type="submit" class="submit-btn">
                    Enviar Mensagem
                </button>

                @if(flashMessages.get('success'))
                  <p style="color:aquamarine; text-align:center; margin-top: 15px;">{{ flashMessages.get('success') }}</p>
                @endif
                @if(flashMessages.get('error'))
                  <p style="color:red; text-align:center; margin-top: 15px;">{{ flashMessages.get('error') }}</p>
                @endif
            </form>
        </div>
        
        <div class="contact-info">
            <h2>Informações de Suporte</h2>
            
            <div class="info-item">
                <i class="ri-mail-line"></i>
                <div>
                    <p>Email de Suporte:</p>
                    <p><a href="mailto:contato@ruralsports.com">contato@ruralsports.com</a></p>
                </div>
            </div>
            
            <div class="info-item">
                <i class="ri-phone-line"></i>
                <div>
                    <p>Telefone / WhatsApp:</p>
                    <p><a href="tel:+559999999999">(XX) XXXX-XXXX</a></p>
                </div>
            </div>
            
            <div class="info-item">
                <i class="ri-map-pin-line"></i>
                <div>
                    <p>Endereço:</p>
                    <p>Rua Exemplo, 123 - Centro</p>
                </div>
            </div>
            
            <div class="info-item">
                <i class="ri-time-line"></i>
                <div>
                    <p>Horário de Atendimento:</p>
                    <p>Segunda a Sexta, 9h às 18h</p>
                </div>
            </div>
            
        </div>
        
    </div>
    
  </div>

  <div id="profileModal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      <h2>Meu Perfil</h2>
      <img id="userAvatar" src="/imagem/logo3.png" alt="Avatar"
        style="width:100px; height:100px; border-radius:50%; margin-bottom:10px;">
      <p><strong>Nome:</strong><input type="text" id="userName" value="Carregando..." readonly></p>
      <p><strong>Email:</strong><input type="email" id="userEmail" value="Carregando..." readonly></p>
      <p><strong>Sexo:</strong><input type="text" id="userSexo" value="Carregando..." readonly></p>
      <div class="buttons">
        <button id="editBtn" class="btn-edit">Editar</button>
        <button id="saveBtn" class="btn-edit" style="display:none;">Salvar</button>
        <button id="cancelBtn" class="btn-logout" style="display:none;">Cancelar</button>
        <form method="POST" action="/logout" style="margin-top:10px;">
          <button type="submit" class="btn-logout">Sair</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    const modal = document.getElementById('profileModal')
    const icon = document.getElementById('profileIcon')
    const closeBtn = document.querySelector('.close')
    const nameField = document.getElementById('userName')
    const emailField = document.getElementById('userEmail')
    const sexoField = document.getElementById('userSexo')

   icon.addEventListener('click', async () => {
  try {
    
    const res = await fetch('/api/profile', {
      method: 'GET',
      credentials: 'include',
    })

    if (!res.ok) throw new Error('Usuário não logado')
    const data = await res.json()
    nameField.value = data.name
    emailField.value = data.email
    sexoField.value = data.sexo || 'Não informado'
    modal.style.display = 'flex'
  } catch (err) {
    console.error('Erro ao carregar perfil:', err)
    modal.style.display = 'flex'
  }
})

    closeBtn.addEventListener('click', () => modal.style.display = 'none')
    window.addEventListener('click', e => { if (e.target === modal) modal.style.display = 'none' })
  </script>
</body>
  <script>
  
  const editBtn = document.getElementById('editBtn')
  const saveBtn = document.getElementById('saveBtn')
  const cancelBtn = document.getElementById('cancelBtn')

  
  let originalValues = {}

  editBtn.addEventListener('click', () => {
   
    originalValues = {
      name: document.getElementById('userName').value,
      email: document.getElementById('userEmail').value,
      sexo: document.getElementById('userSexo').value
    }

    document.querySelectorAll('#userName, #userEmail, #userSexo').forEach(el => {
      el.removeAttribute('readonly')
      el.style.backgroundColor = '#1e1c2e'
    })
    editBtn.style.display = 'none'
    saveBtn.style.display = 'inline-block'
    cancelBtn.style.display = 'inline-block'
  })

  cancelBtn.addEventListener('click', () => {
    
    document.getElementById('userName').value = originalValues.name
    document.getElementById('userEmail').value = originalValues.email
    document.getElementById('userSexo').value = originalValues.sexo

   
    document.querySelectorAll('#userName, #userEmail, #userSexo').forEach(el => {
      el.setAttribute('readonly', true)
      el.style.backgroundColor = 'transparent'
    })
    saveBtn.style.display = 'none'
    cancelBtn.style.display = 'none'
    editBtn.style.display = 'inline-block'
  })

  saveBtn.addEventListener('click', async () => {
    const payload = {
      name: document.getElementById('userName').value,
      email: document.getElementById('userEmail').value,
      sexo: document.getElementById('userSexo').value
    }

    try {
      const res = await fetch('/api/profile/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include', 
        body: JSON.stringify(payload)
      })
      const data = await res.json()

      if (data.success) {
        alert('✅ Perfil atualizado com sucesso!')
       
        originalValues = payload
      } else {
        alert('❌ Erro ao atualizar perfil!')
      }
    } catch (err) {
      alert('❌ Erro de conexão!')
      console.error(err)
    }

    document.querySelectorAll('#userName, #userEmail, #userSexo').forEach(el => {
      el.setAttribute('readonly', true)
      el.style.backgroundColor = 'transparent'
    })
    saveBtn.style.display = 'none'
    cancelBtn.style.display = 'none'
    editBtn.style.display = 'inline-block'
  })
</script>

</html>
