<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meu Carrinho | Rural Sports</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />

  <style>
    /* Reset e Base */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background-color: #0f0c25;
      color: #fff;
      font-family: 'Inter', sans-serif;
      padding-bottom: 40px;
    }

    /* Navbar (Reaproveitada) */
    .nav {
      height: 110px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 50px;
      background-color: #d0d4d5;
      color: #000;
      margin-bottom: 40px;
    }
    .nav-part-1 { display: flex; align-items: center; }
    .nav img { height: 80px; width: auto; margin-right: 60px; cursor: pointer; }
    .nav-part-1 ul { display: flex; list-style: none; }
    .nav-part-1 ul li { margin-right: 40px; font-size: 19px; font-weight: 500; text-transform: uppercase; }
    .nav-part-1 ul li a { text-decoration: none; color: inherit; transition: color 0.3s ease; }
    .nav-part-1 ul li a:hover { color: #2c7a7b; }
    .nav-part-2 i { margin-right: 40px; font-size: 21px; cursor: pointer; color: #000; transition: all 0.3s; }
    .nav-part-2 i:hover { color: #2c7a7b; transform: scale(1.2); }

    /* Estilos do Carrinho */
    .container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 20px;
    }

    h1 {
      color: aquamarine;
      text-align: center;
      margin-bottom: 30px;
      font-size: 32px;
    }

    .empty-cart {
      text-align: center;
      padding: 60px;
      background-color: #14122b;
      border-radius: 20px;
      box-shadow: 0 0 15px rgba(0, 255, 191, 0.08);
    }

    .cart-list {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .cart-item {
      display: flex;
      align-items: center;
      background-color: #14122b;
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .item-img {
      width: 90px;
      height: 90px;
      object-fit: cover;
      border-radius: 10px;
      margin-right: 20px;
      border: 1px solid #333;
    }

    .item-details {
      flex: 1;
    }

    .item-details h3 {
      color: #fff;
      font-size: 18px;
      margin-bottom: 5px;
    }

    .item-details p {
      color: #b6b6b6;
      font-size: 14px;
    }

    /* Controles de Quantidade */
    .quantity-controls {
      display: flex;
      align-items: center;
      background-color: #1e1c2e;
      border-radius: 25px;
      padding: 5px 10px;
      margin-right: 30px;
    }

    .qty-btn {
      background: none;
      border: none;
      color: aquamarine;
      font-size: 18px;
      cursor: pointer;
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: 0.2s;
    }

    .qty-btn:hover {
      color: #fff;
      transform: scale(1.2);
    }

    .qty-value {
      color: #fff;
      font-weight: bold;
      margin: 0 10px;
      width: 20px;
      text-align: center;
    }

    .item-price {
      font-weight: bold;
      color: aquamarine;
      font-size: 18px;
      min-width: 100px;
      text-align: right;
      margin-right: 20px;
    }

    .btn-trash {
      background: none;
      border: none;
      color: #ff4d4d;
      font-size: 20px;
      cursor: pointer;
      transition: 0.2s;
    }

    .btn-trash:hover {
      color: #ff1a1a;
      transform: scale(1.2);
    }

    /* Resumo */
    .cart-summary {
      background-color: #14122b;
      padding: 30px;
      border-radius: 20px;
      margin-top: 30px;
      text-align: right;
      box-shadow: 0 0 15px rgba(0, 255, 191, 0.08);
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      border-bottom: 1px solid #333;
      padding-bottom: 15px;
    }

    .total-label {
      font-size: 20px;
      color: #ccc;
    }

    .total-price {
      font-size: 28px;
      color: aquamarine;
      font-weight: bold;
    }

    .actions {
      display: flex;
      justify-content: flex-end;
      gap: 15px;
    }

    .btn-continue {
      padding: 12px 30px;
      border: 2px solid aquamarine;
      background: transparent;
      color: aquamarine;
      border-radius: 50px;
      text-decoration: none;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn-continue:hover {
      background-color: rgba(0, 255, 191, 0.1);
    }

    .btn-checkout {
      padding: 12px 40px;
      background-color: aquamarine;
      color: #141414;
      border: none;
      border-radius: 50px;
      font-weight: bold;
      font-size: 16px;
      cursor: pointer;
      transition: 0.3s;
    }

    .btn-checkout:hover {
      background-color: rgb(0, 230, 170);
      transform: scale(1.05);
    }

    @media (max-width: 768px) {
      .cart-item { flex-direction: column; text-align: center; }
      .item-img { margin: 0 0 15px 0; }
      .quantity-controls { margin: 15px 0; }
      .item-price { margin: 0 0 15px 0; text-align: center; }
      .actions { flex-direction: column-reverse; }
      .btn-continue, .btn-checkout { width: 100%; text-align: center; }
    }
  </style>
</head>
<body>

  <div class="nav">
    <div class="nav-part-1">
      <img src="/imagem/logo_pagina_inicial.png" alt="logo" onclick="window.location.href='/'" />
      <ul>
        <li><a href="/">Início</a></li>
        <li><a href="/homem">Homem</a></li>
        <li><a href="/mulher">Mulher</a></li>
        <li><a href="/contato">Contato</a></li>
        <li><a href="/meus-pedidos">Meus Pedidos</a></li>
      </ul>
    </div>
    <div class="nav-part-2">
        <i class="ri-user-line" onclick="window.location.href='/login'"></i>
        <i class="ri-search-line"></i>
        <i class="ri-shopping-cart-2-line" style="color: #2c7a7b;"></i>
        <i class="ri-menu-line"></i>
    </div>
  </div>

  <div class="container">
    <h1>Meu Carrinho</h1>

    @if(flashMessages.get('success'))
      <div style="background: rgba(0,255,191,0.1); color: aquamarine; padding: 15px; border-radius: 10px; text-align: center; margin-bottom: 20px;">
        {{ flashMessages.get('success') }}
      </div>
    @endif
    
    @if(flashMessages.get('error'))
      <div style="background: rgba(255, 77, 77, 0.1); color: #ff4d4d; padding: 15px; border-radius: 10px; text-align: center; margin-bottom: 20px;">
        {{ flashMessages.get('error') }}
      </div>
    @endif

    @if(!cart || cart.length === 0)
      <div class="empty-cart">
        <i class="ri-shopping-cart-line" style="font-size: 60px; color: #333; margin-bottom: 20px;"></i>
        <h2>Seu carrinho está vazio</h2>
        <p style="color: #888; margin: 10px 0 30px;">Parece que você ainda não escolheu seus itens.</p>
        <a href="/comprar" class="btn-checkout">Começar a Comprar</a>
      </div>
    @else
      <div class="cart-list">
        @each(item in cart)
          <div class="cart-item">
            <img src="{{ item.imageUrl || '/imagem/logo3.png' }}" alt="{{ item.name }}" class="item-img">
            
            <div class="item-details">
              <h3>{{ item.name }}</h3>
              <p>Preço unitário: R$ {{ item.price.toFixed(2) }}</p>
            </div>

            <div class="quantity-controls">
              <form action="/carrinho/diminuir/{{ item.id }}" method="POST" style="margin:0;">
                <button type="submit" class="qty-btn" title="Diminuir">-</button>
              </form>
              
              <span class="qty-value">{{ item.quantity }}</span>
              
              <form action="/carrinho/adicionar/{{ item.id }}" method="POST" style="margin:0;">
                <button type="submit" class="qty-btn" title="Aumentar">+</button>
              </form>
            </div>

            <span class="item-price">R$ {{ (item.price * item.quantity).toFixed(2) }}</span>
            
            <form action="/carrinho/remover/{{ item.id }}" method="POST" style="margin:0;">
              <button type="submit" class="btn-trash" title="Remover item">
                <i class="ri-delete-bin-line"></i>
              </button>
            </form>
          </div>
        @endeach
      </div>

      <div class="cart-summary">
        <div class="summary-row">
          <span class="total-label">Total do Pedido</span>
          <span class="total-price">R$ {{ total.toFixed(2) }}</span>
        </div>
        
        <div class="actions">
          <a href="/comprar" class="btn-continue">Continuar Comprando</a>
          
          <form action="/checkout" method="POST" style="display:inline;">
            <button type="submit" class="btn-checkout">Finalizar Compra</button>
          </form>
        </div>
      </div>
    @endif
  </div>

</body>
</html>