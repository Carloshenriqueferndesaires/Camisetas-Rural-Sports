<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Detalhes do Produto</title>
  <style>
    body {
      background-color: #0f0c25;
      color: #fff;
      font-family: 'Inter', sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    .card {
      background-color: #14122b;
      padding: 40px;
      border-radius: 20px;
      box-shadow: 0 0 20px rgba(0, 255, 191, 0.1);
      max-width: 400px;
      text-align: center;
    }

    img {
      width: 100%;
      border-radius: 15px;
      object-fit: contain;
      margin-bottom: 20px;
    }

    h2 {
      color: aquamarine;
      margin-bottom: 10px;
    }

    p {
      color: #b6b6b6;
      margin-bottom: 10px;
    }

    span {
      display: block;
      color: aquamarine;
      font-weight: bold;
      font-size: 18px;
      margin-bottom: 20px;
    }

    /* Estilo do botão de voltar */
    a.btn-back {
      text-decoration: none;
      color: #fff;
      background-color: #000;
      padding: 10px 25px;
      border-radius: 50px;
      border-top-left-radius: 0;
      font-weight: 600;
      transition: all 0.3s ease;
      display: inline-block; /* Garante comportamento correto de espaçamento */
    }

    a.btn-back:hover {
      background-color: #2c7a7b;
      transform: scale(1.05);
    }

    /* Novo estilo para o botão de Adicionar ao Carrinho */
    .btn-add {
      background-color: aquamarine; 
      color: #141414; 
      border: none; 
      padding: 12px 30px; 
      border-radius: 50px; 
      font-weight: bold; 
      cursor: pointer; 
      font-size: 16px;
      transition: 0.3s;
      width: 100%;
      margin-bottom: 15px;
    }

    .btn-add:hover {
      background-color: rgb(0, 230, 170);
      transform: scale(1.05);
    }
  </style>
</head>
<body>
  <div class="card">
    @if(product.imageUrl)
      <img src="{{ product.imageUrl }}" alt="Imagem do produto">
    @endif

    <h2>{{ product.name }}</h2>
    <p>{{ product.description }}</p>
    <span>R$ {{ product.price }}</span>

    <form action="/carrinho/adicionar/{{ product.id }}" method="POST">
      <button type="submit" class="btn-add">
        Adicionar ao Carrinho
      </button>
    </form>

    <a href="/produtos" class="btn-back">Voltar</a>
  </div>
</body>
</html>